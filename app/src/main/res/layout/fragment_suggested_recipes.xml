<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Top Header Banner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/secondary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Suggested Recipes"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Strict Match: Only recipes you can make right now"
                android:textSize="13sp"
                android:textColor="#FFE0B2"
                android:layout_marginTop="2dp"/>

            <!-- Mode Selector Button Group -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleSuggestedMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btnTabReady">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabReady"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_ready_to_cook"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:strokeColor="@color/white"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabAlmost"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_almost_there"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:strokeColor="@color/white"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State View -->
    <LinearLayout
        android:id="@+id/layoutSuggestedEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_fire"
            app:tint="@color/text_hint"
            android:contentDescription="No Matches Icon"/>

        <TextView
            android:id="@+id/tvEmptySuggestedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_suggested_msg"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToPantry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Ingredients to Pantry"
            android:layout_marginTop="20dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/secondary"
            app:icon="@drawable/ic_add"/>

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"/>

</LinearLayout>