<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarRecipeDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/secondary"
        app:title="@string/recipe_detail_title"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title & Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Classic Fluffy Omelette"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_clock"
                            app:tint="@color/accent_teal"
                            android:contentDescription="Time Icon"/>

                        <TextView
                            android:id="@+id/tvDetailPrepTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 mins"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="6dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • "
                            android:textColor="@color/text_secondary"/>

                        <TextView
                            android:id="@+id/tvDetailServings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Serves 1"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_dark"/>

                    </LinearLayout>

                    <!-- Match Status Banner -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardDetailMatchStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/status_fresh_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/ivDetailStatusIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/status_fresh"
                                android:contentDescription="Status Icon"/>

                            <TextView
                                android:id="@+id/tvDetailStatusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100% Match • You have all ingredients in your pantry!"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_fresh"
                                android:layout_marginStart="8dp"/>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Ingredients Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_ingredients_needed"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecipeIngredients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Preparation Instructions Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_instructions"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"/>

                    <TextView
                        android:id="@+id/tvDetailInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Step one...\n2. Step two..."
                        android:textSize="15sp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Cooked This Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCookedThis"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="@string/btn_cooked_this"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                app:cornerRadius="27dp"
                app:backgroundTint="@color/primary"
                app:icon="@drawable/ic_fire"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>